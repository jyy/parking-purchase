# Parkonect login (username or email at secure.parkonect.com)
PARKONECT_USERNAME=your@email.com
PARKONECT_PASSWORD=your_password

# Billing / checkout
BILLING_FIRST_NAME=YourFirst
BILLING_LAST_NAME=YourLast
TEXT_RECEIPT_PHONE=5551234567

# Card (MM/YY format for expiry; never commit real values)
CARD_NUMBER=4111111111111111
CARD_EXPIRY=12/28
CARD_CVV=123

# Optional: Backup Card (tried if primary card is declined; never commit real values)
# BACKUP_CARD_NUMBER=4111111111111111
# BACKUP_CARD_EXPIRY=12/28
# BACKUP_CARD_CVV=123

# Optional: run browser headless (true/false; default false for debugging)
# HEADLESS=true

# Optional: DEBUG=true = interactive mode at payment page (Y/n to fill form, Y/n to submit).
# DEBUG=true
