# Parkonect account (login at secure.parkonect.com)
PARKONECT_EMAIL=your@email.com
PARKONECT_PASSWORD=your_password

# Billing / checkout
BILLING_FIRST_NAME=YourFirst
BILLING_LAST_NAME=YourLast
